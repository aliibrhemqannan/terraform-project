    "module.vpc.aws_vpc.vpc" [label="aws_vpc.vpc"];
  }
  "module.ec2.aws_instance.web_app_instances" -> "module.ec2.aws_security_group.webSG";
  "module.ec2.aws_instance.web_app_instances" -> "module.vpc.aws_subnet.private_subnets";
  "module.ec2.aws_security_group.webSG" -> "module.vpc.aws_vpc.vpc";
  "module.vpc.aws_eip.nat_gateway_eip" -> "module.vpc.aws_internet_gateway.internet_gateway";
  "module.vpc.aws_internet_gateway.internet_gateway" -> "module.vpc.aws_vpc.vpc";
  "module.vpc.aws_nat_gateway.nat_gateway" -> "module.vpc.aws_eip.nat_gateway_eip";
  "module.vpc.aws_nat_gateway.nat_gateway" -> "module.vpc.aws_subnet.public_subnets";
